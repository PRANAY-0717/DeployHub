# GitHub OAuth App (GitHub > Settings > Developer settings > OAuth Apps)
# Authorization callback URL must be: <BASE_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Public URL of this server (use your ngrok https URL to enable webhooks)
BASE_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string

# Docker Hub
DOCKER_USER=
# Docker Hub access token. Leave empty if you already ran `docker login`.
DOCKER_PASS=
# Optional: e.g. linux/amd64 when building on Apple Silicon for an x86 cluster
DOCKER_PLATFORM=

# Kubernetes
K8S_NAMESPACE=deploysync
# cloud = LoadBalancer service (EKS/GKE/AKS), local = NodePort (minikube/kind)
CLUSTER_MODE=cloud
# local mode only: host used in the app URL (e.g. output of `minikube ip`)
LOCAL_HOST=

# Webhook (auto-redeploy on git push)
WEBHOOK_SECRET=change-me-webhook-secret

# Optional: comma-separated GitHub usernames allowed to sign in. Empty = any GitHub user.
ALLOWED_GITHUB_USERS=
# Optional: where state.json is kept (default ./data). Set PERSIST_STATE=false to disable.
DATA_DIR=
