<%- include('partials/head', { title: title }) %>

<main id="main" class="app-main">
  <div class="wrap">
    <div class="page-head">
      <div class="page-head__title">
        <h1>Repositories</h1>
        <p class="muted">Deploy any GitHub repository directly to your Kubernetes cluster with automatic stack detection.</p>
      </div>

      <div class="toolbar">
        <div class="search-box">
          <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input id="search" type="search" placeholder="Search repositories…" aria-label="Search repositories">
        </div>
        <div class="select-box">
          <select id="lang" aria-label="Filter by language">
            <option value="">All languages</option>
          </select>
        </div>
      </div>
    </div>

    <!-- Repository Cards Grid -->
    <div id="grid" class="repo-grid" aria-live="polite">
      <div class="empty-state">
        <div class="spinner"></div>
        <p>Loading repositories from GitHub…</p>
      </div>
    </div>
  </div>
</main>

<%- include('partials/foot') %>
