<!DOCTYPE html>
<html lang="en" data-type="software" data-radius="soft" data-ground="sand" data-buttons="solid" data-motion>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title><%= title %> · DeployHub</title>
  <meta name="description" content="Automated GitHub to Docker to Kubernetes CI/CD deployment platform.">
  <meta name="site-kind" content="software">
  <meta name="page-type" content="software">
  <meta name="theme-color" content="#0a0d14">

  <!-- Google Fonts: Chivo & Chivo Mono (dealt for devtool) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Chivo:ital,wght@0,300..900;1,300..900&family=Chivo+Mono:wght@400..600&display=swap" rel="stylesheet">

  <!-- Taste Skill System Stylesheets -->
  <link rel="stylesheet" href="/assets/system.css">
  <link rel="stylesheet" href="/assets/ui/cards.css">
  <link rel="stylesheet" href="/assets/motion/motion.css">
  <link rel="stylesheet" href="/assets/backgrounds/backgrounds.css">
  <link rel="stylesheet" href="/assets/layout/layout.css">
  <link rel="stylesheet" href="/assets/icons/icon.css">

  <!-- Custom App Stylesheet integrating design tokens & components -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Hero entrance & background motion tokens -->
  <script>document.documentElement.classList.add('m-enter');setTimeout(()=>document.documentElement.classList.add('m-enter-done'),700)</script>
  <script src="/assets/backgrounds/backgrounds.js"></script>
</head>
<body<% if (locals.bodyData) { %> data-id="<%= bodyData %>"<% } %>>
  <a class="skip-link" href="#main">Skip to main content</a>
  <%- include('navbar', { active: locals.active || '' }) %>
